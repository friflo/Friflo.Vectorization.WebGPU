<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Friflo.Vectorization.WebGPU.Runtime</AssemblyName>
        <RootNamespace>Friflo.Vectorization.WebGPU.Runtime</RootNamespace>
        
        <!--
        <PackageVersion>0.0.0</PackageVersion>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>
        -->

        <!-- packaging -->
        <Title>Friflo Vectorization WebGPU - Native Runtime Libraries</Title>
        <Authors>Ullrich Praetz</Authors>
        <Description>C# binding and native runtime libraries for WebGPU: Windows, Linux, macOS, Android and iOS</Description>
        <Copyright>Ullrich Praetz</Copyright>
        <PackageProjectUrl>https://github.com/friflo/Friflo.Vectorization.WebGPU</PackageProjectUrl>
        <RepositoryUrl>https://github.com/friflo/Friflo.Vectorization.WebGPU</RepositoryUrl>
        <PackageTags>gpu, vectorization, webgou, wgpu-native, gpu-compute</PackageTags>
        <PackageLicenseUrl></PackageLicenseUrl>
        <PackageIconUrl></PackageIconUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>package-icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>false</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedAllSources>true</EmbedAllSources>
        <!-- packaging: end -->
    </PropertyGroup>
    
    <!-- packaging -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
      <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
      <None Include="package-icon.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <PropertyGroup>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>1591</NoWarn>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
    <!-- packaging: end -->

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
      <None Include="..\runtimes\**\*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <!-- put binaries to the location expected by .nupkg -->
        <PackagePath>runtimes\</PackagePath>
        <Pack>true</Pack>
      </None>
    </ItemGroup>

</Project>
